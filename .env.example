# ============================================================
# TELEGRAM ESCROW BOT — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Bot ──────────────────────────────────────────────────────
BOT_TOKEN=7123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_WEBHOOK_URL=https://yourdomain.com
BOT_WEBHOOK_PATH=/webhook
BOT_WEBHOOK_SECRET=change_this_to_a_random_secret_string

# ── Admin / Moderators ───────────────────────────────────────
# Comma-separated Telegram user IDs
ADMIN_IDS=123456789,987654321

# ── Database ─────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=escrow_bot
POSTGRES_USER=escrow_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql+asyncpg://escrow_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/escrow_bot

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── Security ─────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_64_HEX_CHARS
# AES-256 key for encrypting private keys — MUST be 64 hex chars (32 bytes)
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_FOR_AES256

# ── Escrow Fees ──────────────────────────────────────────────
ESCROW_FEE_PERCENT=1.5
MIN_DEAL_AMOUNT_USD=10.0
MAX_DEAL_AMOUNT_USD=100000.0

# ── Blockchain — TRON / USDT-TRC20 ──────────────────────────
TRON_API_KEY=your_trongrid_api_key_here
TRON_NETWORK=mainnet
# mainnet or shasta (testnet)

# ── Blockchain — Ethereum ────────────────────────────────────
ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID
ETH_CONFIRMATIONS=12

# ── Blockchain — Bitcoin ─────────────────────────────────────
BTC_NETWORK=mainnet
# mainnet or testnet
BLOCKCYPHER_TOKEN=your_blockcypher_api_token_here

# ── Blockchain — Litecoin ────────────────────────────────────
LTC_NETWORK=mainnet
BLOCKCYPHER_TOKEN_LTC=your_blockcypher_api_token_here

# ── Confirmations Required ───────────────────────────────────
USDT_TRC20_CONFIRMATIONS=6
BTC_CONFIRMATIONS=3
ETH_CONFIRMATIONS=12
LTC_CONFIRMATIONS=6

# ── Deal Defaults ────────────────────────────────────────────
DEFAULT_DEAL_DEADLINE_DAYS=7
MAX_DEAL_DEADLINE_DAYS=30
DEAL_EXPIRY_WARNING_HOURS=24

# ── Rate Limiting ────────────────────────────────────────────
MAX_REQUESTS_PER_MINUTE=30
MAX_DEALS_PER_DAY=10

# ── App ──────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ── Referral ─────────────────────────────────────────────────
REFERRAL_BONUS_PERCENT=0.1
