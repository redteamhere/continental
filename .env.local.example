# ── LOCAL DEVELOPMENT .env ───────────────────────────────────
# 1. Copy this to .env  (cp .env.local.example .env)
# 2. Fill in BOT_TOKEN and DATABASE_URL
# 3. Run: python run_local.py

# ── Required ─────────────────────────────────────────────────
BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER

# Free PostgreSQL options:
#   Supabase:  https://supabase.com  → New project → Settings → Database → URI
#   Neon:      https://neon.tech     → New project → Connection string
#   Railway:   https://railway.app   → New project → Postgres → Connect
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ── Optional (bot works without these in LOCAL_DEV mode) ─────
# Redis — leave blank to use in-memory FSM storage (resets on restart)
REDIS_URL=redis://localhost:6379/0

# ── Security ─────────────────────────────────────────────────
# Run: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_any_64_hex_chars
ENCRYPTION_KEY=CHANGE_ME_any_64_hex_chars

# Fake mnemonic — fine for local testing (no real wallets generated)
MASTER_MNEMONIC=abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about

# ── Admin ────────────────────────────────────────────────────
# Your own Telegram user ID (get it from @userinfobot)
ADMIN_IDS=YOUR_TELEGRAM_ID

# ── Local dev flags ──────────────────────────────────────────
LOCAL_DEV=true
DEBUG=true
LOG_LEVEL=DEBUG
ENVIRONMENT=development

# ── Blockchain (ignored in LOCAL_DEV mode) ───────────────────
TRON_API_KEY=dummy
ETH_RPC_URL=dummy
BLOCKCYPHER_TOKEN=dummy
