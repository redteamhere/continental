# Normalize line endings
* text=auto

# Shell scripts — always LF
*.sh text eol=lf

# Python — LF
*.py text eol=lf

# Config files — LF
*.yml text eol=lf
*.yaml text eol=lf
*.ini text eol=lf
*.conf text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.txt text eol=lf
.env.example text eol=lf
Dockerfile text eol=lf
